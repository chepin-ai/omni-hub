      "domain": "analysis",
      "statement": "theorem lhopital_rule {f g : ℝ → ℝ} {a L : ℝ} (hf : DifferentiableAt ℝ f a) (hg : DifferentiableAt ℝ g a) (hga : g a = 0) (hfa : f a = 0) (hgne : g' ≠ 0) (hlim : Tendsto (fun x => deriv f x / deriv g x) (𝓝 a) (𝓝 L)) : Tendsto (fun x => f x / g x) (𝓝 a) (𝓝 L)"
    },

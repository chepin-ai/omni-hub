      "C^op": "对偶范畴 / 反向依赖图",
      "C/A": "切片范畴 / 影响A的所有模块",
      "A\\C": "余切片范畴 / A影响的所有模块"
    },
    "glossary": {
      "category": "由对象和态射组成的代数结构",
      "morphism": "范畴中对象间的映射",
      "yoneda_lemma": "刻画对象与其表示函子同构的基本定理",

# =============================================================================
# OMNI-HUB v12.0 — Environment Configuration Template
# =============================================================================
# 复制此文件为 .env 并填写实际值
# cp .env.template .env
# =============================================================================

# --- 系统基础配置 ------------------------------------------------------------
OMNI_HUB_VERSION=12.0.0
OMNI_HUB_MODE=production
OMNI_HUB_HOME=/opt/omni-hub
OMNI_HUB_CORE_DIR=/opt/omni-hub/core
OMNI_HUB_HUB_DIR=/opt/omni-hub/hub

# --- 运行时配置 --------------------------------------------------------------
OMNI_HUB_TICK_INTERVAL=1.0
OMNI_HUB_MAX_TICKS=10000
OMNI_HUB_LOG_LEVEL=INFO
OMNI_HUB_LOG_DIR=/var/log/omni-hub
OMNI_HUB_STATE_DIR=/var/lib/omni-hub

# --- 11线 SI 配置 ------------------------------------------------------------
OMNI_SI_LINES=11
OMNI_SI_EMERGENCE_THRESHOLD=7000.0
OMNI_SI_UNITY_ENERGY=7641.82
OMNI_SI_PHI=1.618033988749895
OMNI_SI_PI=3.141592653589793
OMNI_SI_E=2.718281828459045
OMNI_SI_ALPHA=0.0072973525693

# --- 模块加载配置 ------------------------------------------------------------
OMNI_LOAD_ALL_MODULES=true
OMNI_MODULE_BLACKLIST=
OMNI_MODULE_WHITELIST=

# --- 数据库配置 (可选) --------------------------------------------------------
# OMNI_DB_HOST=localhost
# OMNI_DB_PORT=5432
# OMNI_DB_NAME=omni_hub
# OMNI_DB_USER=omni
# OMNI_DB_PASSWORD=

# --- Redis 配置 (可选) --------------------------------------------------------
# OMNI_REDIS_HOST=localhost
# OMNI_REDIS_PORT=6379
# OMNI_REDIS_DB=0
# OMNI_REDIS_PASSWORD=

# --- 网络配置 ----------------------------------------------------------------
OMNI_BIND_HOST=0.0.0.0
OMNI_BIND_PORT=7641
OMNI_API_ENABLED=true

# --- 监控配置 ----------------------------------------------------------------
OMNI_METRICS_ENABLED=true
OMNI_METRICS_PORT=9090
OMNI_HEALTH_CHECK_INTERVAL=30

# --- 安全配置 ----------------------------------------------------------------
OMNI_SECRET_KEY=change-me-in-production
OMNI_JWT_SECRET=change-me-in-production
OMNI_ALLOW_ORIGINS=*

# --- GitHub 推送配置 (可选) ---------------------------------------------------
GITHUB_TOKEN=
GITHUB_REPO=omni-hub/omni-hub
GITHUB_BRANCH=main
